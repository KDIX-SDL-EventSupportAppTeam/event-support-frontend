# ============================================================================
# 本番ビルド用の Vite 環境変数サンプル
# ----------------------------------------------------------------------------
# 使い方:
#   1. このファイルを `.env.production` にコピー
#        cp .env.production.example .env.production
#   2. 値を本番用に書き換え（URL を実際の Cloud Run / App Engine の値に）
#   3. `npm run build` で生成される dist/ に値が埋め込まれる
#        ※ Vite は `npm run build` 時に自動で .env.production を読む
#
# 注意:
#   - VITE_ 接頭辞付きの値は **フロントのバンドルに埋め込まれて公開される**。
#     秘密情報（API キー・JWT 等）を絶対に書かないこと
#   - .env.production は Git 管理対象外（.gitignore 済み）
# ============================================================================

# 実 API（Cloud Run）に接続
VITE_DATA_SOURCE=api
VITE_MOCK_API=false

# Cloud Run の URL（gcloud run services describe で取得）
# 例: https://event-support-server-xxxxxx-an.a.run.app/api/v1
VITE_API_BASE_URL=https://event-support-server-REPLACE-an.a.run.app/api/v1

# 旧 Flask API は本番では未使用（必要な場合のみ設定）
# VITE_LEGACY_API_BASE_URL=

# ホーム「アプリフィードバック」リンク先（任意）
# VITE_FEEDBACK_FORM_URL=https://forms.gle/your-form-id
