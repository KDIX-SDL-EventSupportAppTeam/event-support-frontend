# ローカル開発用（コピーして .env にリネーム）

# 例: 設計ドキュメントどおり認証などの v1 API が 3000 番で動く場合
# ホスト名は localhost ではなく 127.0.0.1 を使うこと。
# Windows では localhost が先に IPv6(::1) で解決される一方、サーバーは 0.0.0.0（IPv4 のみ）で
# リッスンしているため、::1 への接続が失敗してから IPv4 にフォールバックする分だけ毎リクエスト
# 遅くなる（実測: localhost 219ms / 127.0.0.1 5.7ms）。
# VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1

# ログイン API の event_id（ローカルのみ。本番では設定しない）
# モック時の既定は 0000。実 API では未設定でもシード UUID が使われる
# VITE_DEV_EVENT_ID=20000000-0000-4000-8000-000000000001
# ログイン・登録画面の初期値（実 API 時の既定は dev@example.com / password123）
# VITE_DEV_LOGIN_EMAIL=dev@example.com
# VITE_DEV_LOGIN_PASSWORD=password123
# VITE_DEV_DISPLAY_NAME=開発用参加者

# バックエンドなしで UI だけ試す（npm run dev の既定）。実 API に繋ぐときは false
# VITE_MOCK_API=false

# ブース・賞の取得元: sample（既定・開発）| api（サーバー）
# VITE_DATA_SOURCE=api

# ホーム「アプリフィードバック」で開くフォーム URL（任意）
# VITE_FEEDBACK_FORM_URL=https://forms.gle/your-form-id
